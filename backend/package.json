{
  "name": "online-shop-backend",
  "version": "1.0.0",
  "description": "Backend API for online shop",
  "main": "server.js",
  "scripts": {
  "start": "node server.js",
  "dev": "nodemon server.js",
  "db:generate": "prisma generate",
  "db:push": "prisma db push",
  "db:studio": "prisma studio",
  "prisma-all": "npx prisma format && npx prisma generate && npx prisma db push",
  "lint": "eslint .",
  "test": "jest --runInBand",
  "test:unit": "jest --runInBand tests/unit",
  "test:integration": "jest --runInBand tests/integration"
  },
  "prisma": {
    "seed": "node ./prisma/seed.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^13.10.0",
    "@prisma/client": "^5.6.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^5.6.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  }
}
